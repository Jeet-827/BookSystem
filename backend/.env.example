# BookMart Backend — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/bookmart
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb://127.0.0.1:27017/bookmart

# ─── JWT Secrets ─────────────────────────────────────────────────────────────
# Generate strong random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Production frontend URL (no trailing slash)
CLIENT_URL=https://your-frontend.vercel.app
# Optional: admin-panel URL if separate
# ADMIN_CLIENT_URL=https://your-admin-panel.vercel.app
# Optional: comma-separated list of extra allowed origins
# EXTRA_ALLOWED_ORIGINS=https://staging.example.com,https://preview.example.com

# ─── Initial Admin Bootstrap (remove after first login) ─────────────────────
# Only used once on first startup when no admin account exists.
# Remove ADMIN_DEFAULT_PASSWORD from env after first login and change the password.
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD

# ─── ImageKit (Book Cover CDN) ────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_REPLACE_ME
IMAGEKIT_PRIVATE_KEY=private_REPLACE_ME
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# ─── Google Drive OAuth (Digital Book File Storage) ──────────────────────────
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_PROJECT_ID=REPLACE_ME
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/callback

# ─── Razorpay (Payments) ─────────────────────────────────────────────────────
# Test keys:  rzp_test_...
# Live keys:  rzp_live_...  (use ONLY in production with real money)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# ─── Seeding (Development / Staging only) ────────────────────────────────────
# Set to "true" to enable node seed.js --force (destructive re-seed)
# Never set to true in production.
# ALLOW_DESTRUCTIVE_SEED=false

# ─── Admin Server URL (if admin-server is deployed separately) ───────────────
# ADMIN_SERVER_URL=https://your-admin-server.onrender.com/
