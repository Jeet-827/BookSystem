# ===================================================
# BookMart Full Stack Application Environment Template
# ===================================================

# Frontend Configuration (frontend/.env)
VITE_API_BASE_URL=/api
VITE_APP_NAME=BookMart Plus
VITE_APP_TAGLINE=Online Bookstore with Instant Digital Downloads & 1-Day Refund

# Customer Backend Configuration (backend/.env)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/bookmart
JWT_SECRET=bookmart_super_secret_jwt_access_key_2024
JWT_REFRESH_SECRET=bookmart_refresh_secret_key_2024_secure
CLIENT_URL=http://localhost:5173

# Admin Server Configuration (admin-server/.env)
ADMIN_PORT=5001
ADMIN_CLIENT_URL=http://localhost:5174
ADMIN_DEFAULT_EMAIL=admin@bookmart.com
ADMIN_DEFAULT_PASSWORD=Admin@123456
