{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/about",
      "dest": "/about/index.html"
    },
    {
      "src": "/about/",
      "dest": "/about/index.html"
    },
    {
      "src": "/contact",
      "dest": "/contact/index.html"
    },
    {
      "src": "/contact/",
      "dest": "/contact/index.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/privacy-policy/index.html"
    },
    {
      "src": "/privacy-policy/",
      "dest": "/privacy-policy/index.html"
    },
    {
      "src": "/terms-of-service",
      "dest": "/terms-of-service/index.html"
    },
    {
      "src": "/terms-of-service/",
      "dest": "/terms-of-service/index.html"
    },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
