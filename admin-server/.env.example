# BookMart Dedicated Admin Server — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Server
PORT=5001
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/bookmart

# Authentication Secrets (Generate using: openssl rand -hex 64)
JWT_SECRET=REPLACE_WITH_STRONG_ADMIN_JWT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_ADMIN_REFRESH_SECRET

# Allowed Origins
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
ADMIN_SERVER_URL=http://localhost:5001

# Bootstrap Initial Administrator (One-time bootstrap, change immediately)
ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_STRONG_BOOTSTRAP_KEY
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
